  "scoring_rules": [
    {
      "layer": "SOURCE",
      "rule": "Preserve QAA field benchmark and NASPAA accreditation layers."
    },
    {
      "layer": "EVALUATOR_DESIGN",
      "rule": "Surface values and tradeoffs; do not convert political preference into an evidence score."
    }
  ],
  "performance_levels": [
    {
      "level": "emerging",
      "description": "describes a policy preference with partial evidence or stakeholder coverage"
    },
    {
      "level": "proficient",
      "description": "compares feasible options with evidence, implementation, burdens, and uncertainty"
    },
    {
      "level": "transfer",
      "description": "handles contested values and revises after implementation evidence"
    }
  ],
  "failure_modes": [
    {
      "id": "FM1",
      "name": "preference as evidence"
    },
    {
      "id": "FM2",
      "name": "stakeholder omission"
    },
    {
      "id": "FM3",
      "name": "implementation blindness"
    },
    {
      "id": "FM4",
      "name": "agent as accountable decision-maker"
    }
  ],
  "constraints": [
    {
      "id": "C1",
      "constraint": "label QAA field benchmark and NASPAA MPA or MPP accreditation scope"
    },
    {
      "id": "C2",
      "constraint": "include affected-group and accessibility review"
    },
    {
      "id": "C3",
      "constraint": "public values remain explicit"
    }
  ],
  "risk_considerations": [
    {
      "risk": "distributional harm",
      "control": "burden and equity analysis"
    },
    {
      "risk": "participation exclusion",
      "control": "stakeholder and accessibility audit"
    },
    {
      "risk": "political misuse",
      "control": "evidence and value separation"
    }
  ],
  "agent_instructions": {
    "allowed_role": "organize evidence and generate options for human review",
    "must_do": [
      "map stakeholders",
      "state values",
      "show evidence limits",
      "include implementation and evaluation"
    ],
    "must_not_do": [
      "hide contested values",
      "declare public legitimacy",
      "speak for affected groups"
    ],
    "human_accountability": "decision authority and affected stakeholders remain human"
  },
  "evaluator_checks": [
    {
      "id": "EV1",
      "check": "problem and decision authority are defined"
    },
    {
      "id": "EV2",
      "check": "affected populations and missing voices are visible"
    },
    {
      "id": "EV3",
      "check": "options include feasibility, burdens, and evidence"
    },
    {
      "id": "EV4",
      "check": "learning loop is specified"
    }
  ],
  "test_cases": [
    {
      "id": "TC1",
      "fixture": "conflicting stakeholder values",
      "expected": "values and tradeoffs explicit"
    },
    {
      "id": "TC2",
      "fixture": "weak evidence",
      "expected": "uncertainty and nonrecommendation option"
    },
    {
      "id": "TC3",
      "fixture": "implementation barrier",
      "expected": "revised feasible option"
    },
    {
      "id": "TC4",
      "fixture": "missing affected group",
      "expected": "MISSING_STAKEHOLDER"
    }
  ],
