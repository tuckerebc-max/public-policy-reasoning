        "F2-67-006"
      ]
    },
    {
      "layer": "SOURCE",
      "statement": "NASPAA identifies public leadership, policy process, critical analysis and evidence-informed decisions, public-service perspective, and communication.",
      "source_ids": [
        "F2-67-007"
      ]
    },
    {
      "layer": "SOURCE",
      "statement": "NASPAA Standard 5 links competencies, evidence, assessment, and continuous improvement.",
